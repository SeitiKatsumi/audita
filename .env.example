# Application
APP_ENV=local
APP_URL=http://localhost:3000
PORT=3001
HOST=127.0.0.1

# Database
DATABASE_URL=postgres://audita_app_staging:change-me@srv-captain--audita-db-staging:5432/audita_staging
AUDITA_AUTO_MIGRATE=true
DB_POOL_MAX=5
DB_SSL=false
AUDITA_AUTH_REQUIRED=true
AUDITA_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUDITA_BOOTSTRAP_ADMIN_PASSWORD=change-me
AUDITA_BOOTSTRAP_ADMIN_NAME=Audita Admin
COOKIE_SECURE=true
OPENAI_API_KEY=change-me
PORTAL_TRANSPARENCIA_API_KEY=change-me
CONECTA_GOV_CNPJ_TOKEN=change-me
CONECTA_GOV_CND_TOKEN=change-me
AUDIT_CACHE_TTL_SECONDS=900
AUDIT_COLLECTOR_TIMEOUT_MS=12000
AUDIT_COLLECTOR_RETRIES=1
TJDFT_HEADLESS=true
FGTS_HEADLESS=true
FGTS_COLLECTOR_TIMEOUT_MS=90000
FGTS_STEP_TIMEOUT_MS=30000

# Auth
AUTH_SECRET=change-me

# AI
AI_PROVIDER=change-me
AI_API_KEY=change-me

# WhatsApp
WHATSAPP_PROVIDER=change-me
