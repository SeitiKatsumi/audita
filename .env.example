# Application
APP_ENV=local
APP_URL=http://localhost:3000
PORT=3001
HOST=127.0.0.1

# Database
DATABASE_URL=postgres://audita_app_staging:change-me@srv-captain--audita-db-staging:5432/audita_staging
AUDITA_AUTO_MIGRATE=true
DB_POOL_MAX=5
DB_SSL=false
AUDITA_AUTH_REQUIRED=true
AUDITA_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUDITA_BOOTSTRAP_ADMIN_PASSWORD=change-me
AUDITA_BOOTSTRAP_ADMIN_NAME=Audita Admin
COOKIE_SECURE=true
# Chave aleatoria de pelo menos 32 caracteres para criptografar perfis cadastrais.
# Nao altere esta chave depois de existirem perfis salvos sem antes migrar os dados.
AUDITA_PROFILE_ENCRYPTION_KEY=change-me
# Chave de inferencia exclusiva do projeto OpenAI "Audita".
AUDITA_OPENAI_API_KEY=change-me
OPENAI_AUDITA_API_KEY_SECRET=AUDITA_OPENAI_API_KEY
AUDITA_CHAT_API_KEY_SECRET=AUDITA_OPENAI_API_KEY
AUDITA_CHAT_MODEL=gpt-5-mini
AUDITA_CHAT_MAX_TURNS=8
AUDITA_CHAT_TIMEOUT_MS=90000
# Analise temporaria de faturas Itau no chat. Usa a mesma chave do projeto por padrao.
ITAU_ANALYSIS_API_KEY_SECRET=AUDITA_OPENAI_API_KEY
ITAU_ANALYSIS_MODEL=gpt-5-mini
# Chave administrativa da organizacao, usada somente no backend para Usage/Costs.
OPENAI_ADMIN_KEY=change-me
OPENAI_PROJECT_ID=proj_change-me
OPENAI_AUDITA_API_KEY_ID=key_change-me
OPENAI_ORGANIZATION_ID=
OPENAI_USAGE_SYNC_ENABLED=true
OPENAI_USAGE_BASE_URL=https://api.openai.com/v1
OPENAI_USAGE_TIMEOUT_MS=20000
PORTAL_TRANSPARENCIA_API_KEY=change-me
BIGDATACORP_ACCESS_TOKEN=change-me
BIGDATACORP_TOKEN_ID=change-me
BIGDATACORP_MARKETPLACE_URL=https://plataforma.bigdatacorp.com.br/marketplace
BIGDATACORP_CNIB_ENABLED=false
# Consulta processual somente leitura da Direct Data.
DIRECT_DATA_TJ_ENABLED=false
DIRECT_DATA_TOKEN=change-me
DIRECT_DATA_API_BASE_URL=https://apiv3.directd.com.br/api
# Cobertura confirmada na pagina do produto em 2026-07-29.
DIRECT_DATA_TJ_SUPPORTED_UFS=PE,PI,SC,SP
DIRECT_DATA_TJ_TIMEOUT_MS=60000
DIRECT_DATA_TJ_CREDIT_COST=1
# Ajuste conforme o contrato; o valor publico observado era R$ 0,36 por retorno.
DIRECT_DATA_TJ_QUERY_COST_BRL=0.36
# ONR WSRIDIGITAL: habilite somente depois do convenio e da homologacao oficial.
ONR_WSRIDIGITAL_ENABLED=false
ONR_WSRIDIGITAL_ENVIRONMENT=homologation
ONR_WSRIDIGITAL_PARTNER_ID=
ONR_WSRIDIGITAL_KEY=change-me
ONR_WSRIDIGITAL_USER_EMAIL=
ONR_WSRIDIGITAL_USER_CPF=
ONR_WSRIDIGITAL_REQUESTER_NAME=
ONR_WSRIDIGITAL_REQUESTER_EMAIL=
ONR_WSRIDIGITAL_REQUESTER_CPF=
ONR_WSRIDIGITAL_PURPOSE=
ONR_WSRIDIGITAL_ECPF_CPF=
ONR_WSRIDIGITAL_ECPF_EMAIL=
ONR_WSRIDIGITAL_ECPF_ISSUER=
ONR_WSRIDIGITAL_ECPF_PUBLIC_KEY=
ONR_WSRIDIGITAL_ECPF_SERIAL_NUMBER=
ONR_WSRIDIGITAL_ECPF_SUBJECT_CN=
ONR_WSRIDIGITAL_ECPF_VALID_UNTIL=
ONR_WSRIDIGITAL_TIMEOUT_MS=20000
ONR_WSRIDIGITAL_HASH_CASE=upper
# Homologacao usa os endpoints oficiais abaixo por padrao. Em producao, configure
# explicitamente as URLs fornecidas pelo ONR para o convenio da Audita.
ONR_WSRIDIGITAL_LOGIN_URL=https://hml3-ws.onr.org.br/logincliente.asmx
ONR_WSRIDIGITAL_STATES_URL=https://hml3-ws.onr.org.br/estados.asmx
ONR_WSRIDIGITAL_REGISTRY_OFFICES_URL=https://hml3-ws.onr.org.br/cartorios.asmx
ONR_WSRIDIGITAL_PESQUISA_PREVIA_URL=https://hml3-ws.onr.org.br/pesquisaprevia.asmx
ONR_WSRIDIGITAL_CERTIDOES_URL=https://hml3-ws.onr.org.br/certidoes.asmx
ONR_WSRIDIGITAL_CONSULTA_ELETRONICA_URL=https://hml3-ws.onr.org.br/consultaeletronica.asmx
ONR_WSRIDIGITAL_CREDITOS_URL=https://hml3-ws.onr.org.br/creditos.asmx
AUDITA_CREDITS_ENABLED=false
AUDITA_INITIAL_CREDITS=0
AUDITA_PROPERTY_CREDITS_PESQUISA_PREVIA=1
AUDITA_PROPERTY_CREDITS_PESQUISA_QUALIFICADA=2
AUDITA_PROPERTY_CREDITS_CERTIDAO_DIGITAL=2
AUDITA_PROPERTY_CREDITS_INDISPONIBILIDADE=1
CONECTA_GOV_CNPJ_TOKEN=change-me
CONECTA_GOV_CND_TOKEN=change-me
AUDIT_CACHE_TTL_SECONDS=900
AUDIT_COLLECTOR_TIMEOUT_MS=12000
AUDIT_COLLECTOR_RETRIES=1
AUDITA_CAPTCHA_LAB_MODE=false
AUDITA_REMOTE_ASSISTED_BROWSER=true
# O protocolo JEC do fluxo Itau e manual por padrao. Ative apenas quando a
# experiencia de navegador voltar a ser homologada para essa jornada.
AUDITA_JEC_BROWSER_ENABLED=false
# Navegador ao vivo exclusivo do /chat e preservado para futuras jornadas.
AUDITA_CHAT_LIVE_BROWSER_ENABLED=false
AUDITA_CHAT_BROWSER_PROVIDER=steel
STEEL_BROWSER_URL=http://127.0.0.1:3000
AUDITA_CHAT_BROWSER_MAX_SESSIONS=1
AUDITA_CHAT_BROWSER_SESSION_TIMEOUT_MS=900000
AUDITA_CHAT_BROWSER_ALLOW_HTTP_LOCAL=false
STATE_COURT_ASSISTED_HEADLESS=true
STATE_COURT_KEEP_ASSISTED_OPEN=true
STATE_COURT_ASSISTED_SLOW_MO_MS=150
STATE_COURT_STEP_TIMEOUT_MS=30000
STATE_COURT_NAV_TIMEOUT_MS=45000
STATE_COURT_AGENT_ASSISTED_UFS=AC,AP,MG,MT,PA,PI,RJ,RN,RO,RR,RS,SC
STATE_COURT_AGENT_API_KEY_SECRET=AUDITA_OPENAI_API_KEY
STATE_COURT_AGENT_MODEL=gpt-5-mini
STATE_COURT_AGENT_MAX_TURNS=24
STATE_COURT_AGENT_RUN_TIMEOUT_MS=180000
TJDFT_HEADLESS=true
FGTS_HEADLESS=true
FGTS_COLLECTOR_TIMEOUT_MS=90000
FGTS_STEP_TIMEOUT_MS=30000
CNDT_HEADLESS=true
CNDT_COLLECTOR_TIMEOUT_MS=60000
CNDT_STEP_TIMEOUT_MS=30000
TRF1_HEADLESS=true
TRF1_COLLECTOR_TIMEOUT_MS=120000
TRF1_STEP_TIMEOUT_MS=45000
TRF1_NETWORK_IDLE_TIMEOUT_MS=20000

# Auth
AUTH_SECRET=change-me

# AI
AI_PROVIDER=change-me
AI_API_KEY=change-me

# WhatsApp
WHATSAPP_PROVIDER=change-me
WHATSAPP_TOKEN=change-me

# Observability
LOG_LEVEL=info
